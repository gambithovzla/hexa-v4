{
  "name": "hexa-v4",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "node --watch server/index.js",
    "start": "node server/index.js",
    "client": "cd client && npm run dev",
    "dev:all": "concurrently \"npm run dev\" \"npm run client\"",
    "audit": "node scripts/system-audit.js",
    "smoke:mlb": "node scripts/smoke/mlb-release-smoke.js",
    "smoke:nba": "node scripts/smoke/nba-release-smoke.js",
    "smoke:parlay": "node scripts/smoke/parlay-architect-smoke.js",
    "smoke:props": "node scripts/smoke/props-board-smoke.js",
    "prop-brier-gate": "node --env-file=.env scripts/training/prop-brier-gate.js",
    "smoke:go-live": "node scripts/smoke/nba-release-smoke.js && node scripts/smoke/parlay-architect-smoke.js",
    "test:go-live": "node --test server/services/__tests__/parlayResolver.test.js server/services/__tests__/parlayRunOutcome.test.js server/services/__tests__/pick-tracker-nba.test.js server/services/__tests__/postmortemSport.test.js server/services/__tests__/nbaOutputGuard.test.js server/services/__tests__/nbaTeamMap.test.js server/services/__tests__/mlModelHealth.test.js server/services/__tests__/sport-isolation.test.js",
    "verify:ml:persistence": "node scripts/ops/verify-ml-persistence.js",
    "test:mlb:critical": "node --test server/__tests__/pick-resolver.test.js server/__tests__/closing-line-capture.test.js server/__tests__/picks-payload-guardrails.test.js server/services/__tests__/admin-equity.test.js",
    "regrade-backtest-props": "node scripts/regrade-backtest-props.js",
    "force_rebuild": "echo 1",
    "test:parlay": "node --test server/services/parlayEngine/__tests__/pool.test.js server/services/parlayEngine/__tests__/risk.test.js server/services/parlayEngine/__tests__/correl.test.js server/services/parlayEngine/__tests__/composer.test.js server/services/parlayEngine/__tests__/architect.test.js server/services/parlayEngine/__tests__/market-focus.test.js",
    "test:parsers": "node --test server/parsers/__tests__/pickParser.test.js",
    "training:backfill": "node scripts/training/backfill-pick-features.js",
    "training:export": "node scripts/training/export-dataset.js",
    "migrate:up": "node-pg-migrate --migrations-dir database/migrations --database-url-var DATABASE_URL up",
    "migrate:down": "node-pg-migrate --migrations-dir database/migrations --database-url-var DATABASE_URL down",
    "migrate:create": "node-pg-migrate --migrations-dir database/migrations create"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.0",
    "@sentry/node": "^10.55.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "discord.js": "^14.26.4",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "resend": "^6.10.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
