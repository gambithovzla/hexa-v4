# Anthropic API Key - get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# xAI / Grok API Key - get yours at https://console.x.ai
XAI_API_KEY=your_xai_api_key_here

# The Odds API key - required for real MLB moneyline/runline/total odds
ODDS_API_KEY=your_the_odds_api_key_here
ODDS_API_BACKUP_KEY=your_secondary_the_odds_api_key_here

# Optional: filter odds to a single bookmaker (read exactly what that book shows).
# Common values: bet365, pinnacle, williamhill, unibet, betfair_ex_eu.
# When set, ODDS_API_REGIONS defaults to 'us,uk,eu,au' to widen the search.
# Leave empty for the default behavior (regions=us + top-3 books consensus).
ODDS_API_BOOKMAKER=
ODDS_API_REGIONS=

# Optional xAI model overrides for admin-only Grok / Dual engine mode
XAI_ORACLE_MODEL=grok-4-fast-reasoning
XAI_SAFE_MODEL=grok-4-fast-reasoning

# Optional content draft model override (defaults to Claude Haiku)
CONTENT_DRAFT_MODEL=claude-haiku-4-5-20251001

# Server port (default: 3001)
PORT=3001

# Node environment
NODE_ENV=development

# JWT secret - change this to a strong random value in production
JWT_SECRET=hexa-v4-super-secret-key-change-in-production

# Transactional email (required for verification and password reset codes)
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=H.E.X.A. Oracle <noreply@hexaoracle.lat>

# PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@localhost:5432/hexadb

# Content API keys for external read-only consumers (format: label:secret,label2:secret2)
CONTENT_API_KEYS=socialmedia:replace_me

# X publishing (optional) - used by the editorial queue for manual/scheduled posting
# Preferred: OAuth 1.0a user-context credentials for the brand account that will publish
X_CONSUMER_KEY=your_x_consumer_key_here
X_CONSUMER_SECRET=your_x_consumer_secret_here
X_ACCESS_TOKEN=your_x_access_token_here
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret_here
#
# Optional fallback: OAuth 2.0 user bearer token if you already implemented that flow
X_USER_ACCESS_TOKEN=your_x_user_access_token_here
X_API_BASE_URL=https://api.x.com
X_AUTO_PUBLISH_ENABLED=0
X_AUTO_PUBLISH_INTERVAL_MINUTES=5

# ── Telegram Channel Publisher (S4) ──────────────────────────────────────────
# Publishes content_queue items with publish_target='telegram' to a Telegram channel/group.
# Get a bot token from @BotFather; CHANNEL_ID can be @channel_username or -100xxxxxxxxxx.
# Shares the same cadence as X_AUTO_PUBLISH_INTERVAL_MINUTES.
TELEGRAM_ENABLED=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# ── Newsletter (S5) ───────────────────────────────────────────────────────────
# Weekly HTML recap sent via Resend to newsletter_subscribers (shared RESEND_API_KEY).
# Fires every Sunday at 09:00 ET when enabled. Trigger manually:
#   POST /api/admin/newsletter/send-weekly  { lang: 'es'|'en' }
NEWSLETTER_ENABLED=0

# ── Observability (B6) ────────────────────────────────────────────────────────
# Sentry DSN for error tracking. Leave blank to disable (no-op).
# Structured JSON logging (pino) is always on; set LOG_LEVEL=debug for verbose.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05
LOG_LEVEL=info

# ── Beat reporters injury scanner (A8) ────────────────────────────────────────
# Requires X API v2 Bearer Token (separate from OAuth 1.0a posting credentials).
# Scans curated MLB beat reporter accounts hourly; classifies with Haiku.
BEAT_REPORTER_ENABLED=0
X_BEARER_TOKEN=

# ── Discord bot (B3) ──────────────────────────────────────────────────────────
# Slash commands: /today, /pick, /futures, /injuries
# Get token from Discord Developer Portal → Bot → Token
DISCORD_ENABLED=0
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
DISCORD_ADMIN_ROLE=

# ── Threads (Meta) publisher (B4) ─────────────────────────────────────────────
# Requires Threads API access (Meta App with threads_basic + threads_content_publish).
THREADS_ENABLED=0
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# Oracle Embeddings / RAG (A3) — requires pgvector in Postgres
# If not set, embedding service is a no-op and RAG block is skipped
OPENAI_EMBED_API_KEY=

# Shadow Mode (admin-only observability for the local tabular validator)
SHADOW_MODE_ENABLED=true
SHADOW_MODE_MODEL_KEY=xgboost_validator_v1
SHADOW_MODE_MODEL_VERSION=1

# Parlay Synergy Engine (new parallel engine — set to true only in staging/production when ready)
PARLAY_SYNERGY_ENABLED=false

# NBA Analysis (Sprint 7 MVP — admin-only until stable)
NBA_ANALYSIS_ENABLED=false

# Pick Imperdible (admin-only "lock of the slate" mode — MLB).
# Analyzes 1..N confirmed-lineup games and returns a single highest-conviction
# bet (or PASS). Selection is conviction-based (model+market+ML agreement, low
# variance), edge is never rewarded; an LLM arbiter audits the finalists.
IMPERDIBLE_ENABLED=false
# Override the arbiter model (default Opus). e.g. claude-sonnet-4-6 to cut cost.
# IMPERDIBLE_ARBITER_MODEL=claude-opus-4-7
# How many top candidates get the ML-sidecar alignment pass (default 5).
# IMPERDIBLE_TOP_K=5

# NowPayments (crypto payment gateway — sole active gateway)
# Get keys at https://account.nowpayments.io → Settings → API keys / IPN settings
NOWPAYMENTS_API_KEY=your_nowpayments_api_key_here
NOWPAYMENTS_IPN_SECRET=your_nowpayments_ipn_secret_here
# Use https://api-sandbox.nowpayments.io for the sandbox environment
NOWPAYMENTS_API_BASE=https://api.nowpayments.io
# Used for success_url / cancel_url on hosted invoices
FRONTEND_URL=https://hexa-v4.vercel.app

# ── ML Sidecar (Sprint 2 / 3 / 4) ────────────────────────────────────────────
# Python FastAPI + XGBoost service deployed alongside the Node API.
# When disabled, the legacy deterministic xgboostValidator.js handles everything.
ML_SIDECAR_ENABLED=false
HEXA_ML_API_URL=
HEXA_ML_INTERNAL_TOKEN=

# Admin analyze: longer timeout for pick-aligned Python scoring (ms, default 2500)
ML_ADMIN_TIMEOUT_MS=2500

# Sprint 4: meta-learner that combines Oracle + legacy validator + Python XGBoost.
# Only takes effect when ML_SIDECAR_ENABLED=true AND the ensemble has been
# trained (POST /retrain/ensemble on the sidecar). The /api/analyze/game-ensemble
# endpoint is purely annotation — it does not change the Oracle flow.
ENSEMBLE_ENABLED=false

# Sprint 5 — MLB Player Props ML
MLB_PROPS_SAVANT_ENRICH_ENABLED=1
MLB_PROPS_ML_PUBLIC_ENABLED=0
MLB_PROPS_ML_MIN_RESOLVED=100
